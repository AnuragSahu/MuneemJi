    <string name="app_name">MuneemJi</string>
    <style name="Theme.MuneemJi" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#0B0F1A</item>
        <item name="android:navigationBarColor">#0B0F1A</item>
